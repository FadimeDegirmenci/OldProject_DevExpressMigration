<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Stokify">

    <ScrollView>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Baslik -->
            <Frame Grid.Row="0" 
                   BackgroundColor="#2E86AB" 
                   CornerRadius="10"
                   Margin="0,0,0,20"
                   Padding="20">
                <Label Text="Stokify-Stok Yönetim Sistemi"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Frame>

          

            <!-- Menu Butonlari -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Urun Yonetimi -->
                <Frame Grid.Row="0" Grid.Column="0"
                       BackgroundColor="#28A745"
                       CornerRadius="15"
                       Margin="5"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProductManagementTapped" />
                    </Frame.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📦" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Ürün Yönetimi" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Listele ve Ekle" 
                               FontSize="12" 
                               TextColor="#E8F5E8"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>

                
                <Frame Grid.Row="0" Grid.Column="1"
       BackgroundColor="#17A2B8"
       CornerRadius="15"
       Margin="5"
       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWarehouseManagementTapped" />
                    </Frame.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🏪" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Depo Yönetimi" 
               FontSize="16" 
               FontAttributes="Bold" 
               TextColor="White"
               HorizontalOptions="Center" />
                        <Label Text="Depo Ekle ve Yönet" 
               FontSize="12" 
               TextColor="#E3F7FA"
               HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>

                

                <!-- Depo Yonetimi -->
                <Frame Grid.Row="1" Grid.Column="0"
                       BackgroundColor="#FFC107"
                       CornerRadius="15"
                       Margin="5"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStockOperationTapped" />
                    </Frame.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Stok İşlemleri" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#495057"
                               HorizontalOptions="Center" />
                        <Label Text="Stok Girişi-Çıkışı" 
                               FontSize="12" 
                               TextColor="#856404"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>

               

                <!-- Dashboard/Raporlar -->
                <Frame Grid.Row="1" Grid.Column="1"
       BackgroundColor="#6F42C1"
       CornerRadius="15"
       Margin="5"
       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped" />
                    </Frame.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Raporlar" 
               FontSize="16" 
               FontAttributes="Bold" 
               TextColor="White"
               HorizontalOptions="Center" />
                        <Label Text="Özetler ve İstatistikler" 
               FontSize="12" 
               TextColor="#F3E8FF"
               HorizontalOptions="Center" />
                    </StackLayout>
                </Frame>

            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>