<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.DevExpressPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             Title="DevExpress Layout Karşılaştırma">

    <ScrollView>
        <StackLayout Padding="20" Spacing="25">

            <Label Text="🎨 DevExpress Layout Karşılaştırma"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#2E86AB" />

            <!-- ============ 1. DXStackLayout ============ -->
            <Label Text="1️⃣ DXStackLayout" FontSize="18" FontAttributes="Bold" TextColor="#28A745"/>
            <Label Text="Elemanları tek bir satırda (ya da sütunda) sırayla dizer. Sığmasa taşar, alt satıra geçmez."
                   FontSize="13" TextColor="#6C757D"/>

            <dx:DXStackLayout Orientation="Horizontal" ItemSpacing="10" HeightRequest="90">
                <dx:DXBorder BackgroundColor="#28A745" CornerRadius="10" WidthRequest="70">
                    <Label Text="1" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#17A2B8" CornerRadius="10" WidthRequest="70">
                    <Label Text="2" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#FFC107" CornerRadius="10" WidthRequest="70">
                    <Label Text="3" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#6F42C1" CornerRadius="10" WidthRequest="70">
                    <Label Text="4" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
            </dx:DXStackLayout>

            <!-- ============ 2. DXDockLayout ============ -->
            <Label Text="2️⃣ DXDockLayout" FontSize="18" FontAttributes="Bold" TextColor="#17A2B8" Margin="0,15,0,0"/>
            <Label Text="Her elemanı bir kenara (Üst/Alt/Sol/Sağ) yapıştırır, son eklenen (Dock belirtilmeyen) kalan boşluğu (ortayı) doldurur."
                   FontSize="13" TextColor="#6C757D"/>

            <dx:DXDockLayout HeightRequest="220" HorizontalSpacing="6" VerticalSpacing="6">
                <dx:DXBorder dx:DXDockLayout.Dock="Top" BackgroundColor="#DC3545" CornerRadius="8" HeightRequest="45">
                    <Label Text="Top" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder dx:DXDockLayout.Dock="Bottom" BackgroundColor="#DC3545" CornerRadius="8" HeightRequest="45">
                    <Label Text="Bottom" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder dx:DXDockLayout.Dock="Left" BackgroundColor="#28A745" CornerRadius="8" WidthRequest="80">
                    <Label Text="Left" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder dx:DXDockLayout.Dock="Right" BackgroundColor="#28A745" CornerRadius="8" WidthRequest="80">
                    <Label Text="Right" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <!-- Dock belirtilmedi -> kalan orta boşluğu dolduruyor -->
                <dx:DXBorder BackgroundColor="#6F42C1" CornerRadius="8">
                    <Label Text="Fill (Orta)" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
            </dx:DXDockLayout>

            <!-- ============ 3. DXWrapLayout ============ -->
            <Label Text="3️⃣ DXWrapLayout" FontSize="18" FontAttributes="Bold" TextColor="#FFC107" Margin="0,15,0,0"/>
            <Label Text="Elemanları soldan sağa sırayla dizer, satır sığmayınca otomatik alt satıra geçer (web'deki Flexbox gibi)."
                   FontSize="13" TextColor="#6C757D"/>

            <dx:DXWrapLayout ItemSpacing="8" LineSpacing="8">
                <dx:DXBorder BackgroundColor="#FD7E14" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 1" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#20C997" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 2" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#0D6EFD" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 3" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#E83E8C" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 4" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#6610F2" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 5" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
                <dx:DXBorder BackgroundColor="#198754" CornerRadius="10" WidthRequest="90" HeightRequest="60">
                    <Label Text="Kutu 6" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </dx:DXBorder>
            </dx:DXWrapLayout>

            <dx:DXButton Content="Test Butonu"
                         BackgroundColor="#2E86AB"
                         TextColor="White"
                         CornerRadius="12"
                         PressedScale="0.95"
                         HeightRequest="50"
                         Margin="0,15,0,0"
                         Clicked="OnTestButtonClicked" />

        </StackLayout>
    </ScrollView>

</ContentPage>