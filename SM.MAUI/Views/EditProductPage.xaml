<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.EditProductPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Ürün Düzenle"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Frame Grid.Row="0" 
                   BackgroundColor="#667EEA" 
                   CornerRadius="15"
                   Margin="0,0,0,25"
                   Padding="25">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                    <Label Text="✏️" FontSize="28" VerticalOptions="Center" />
                    <Label Text="Ürün Düzenle"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"
                           Margin="10,0,0,0" />
                </StackLayout>
            </Frame>

            <!-- Ana İçerik -->
            <StackLayout Grid.Row="1" Spacing="20">

                <!-- Ürün Bilgileri -->
                <Frame BackgroundColor="White" 
                       CornerRadius="15" 
                       Padding="20">
                    <StackLayout Spacing="20">
                        <Label Text="📝 Ürün Bilgileri" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#2E3A59" />

                        <!-- Ürün Adı -->
                        <StackLayout Spacing="8">
                            <Label Text="Ürün Adı *" 
                                   FontAttributes="Bold" 
                                   TextColor="#2E3A59" />
                            <Entry x:Name="ProductNameEntry"
                                   Text="{Binding ProductName}" 
                                   Placeholder="Ürün adını girin"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#2E3A59" />
                            <Label Text="{Binding NameError}"
                                   TextColor="Red"
                                   FontSize="12"
                                   IsVisible="{Binding NameError, Converter={StaticResource StringToBoolConverter}}" />
                        </StackLayout>

                        <!-- SKU -->
                        <StackLayout Spacing="8">
                            <Label Text="SKU *" 
                                   FontAttributes="Bold" 
                                   TextColor="#2E3A59" />
                            <Entry Text="{Binding ProductSKU}" 
                                   Placeholder="Stok kodu"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#2E3A59" />
                            <Label Text="{Binding SKUError}"
                                   TextColor="Red"
                                   FontSize="12"
                                   IsVisible="{Binding SKUError, Converter={StaticResource StringToBoolConverter}}" />
                        </StackLayout>

                        <!-- Fiyat -->
                        <StackLayout Spacing="8">
                            <Label Text="Fiyat *" 
                                   FontAttributes="Bold" 
                                   TextColor="#2E3A59" />
                            <Entry Text="{Binding ProductPrice}" 
                                   Placeholder="Fiyat"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#2E3A59" />
                            <Label Text="{Binding PriceError}"
                                   TextColor="Red"
                                   FontSize="12"
                                   IsVisible="{Binding PriceError, Converter={StaticResource StringToBoolConverter}}" />
                        </StackLayout>

                        <!-- Açıklama -->
                        <StackLayout Spacing="8">
                            <Label Text="Açıklama" 
                                   FontAttributes="Bold" 
                                   TextColor="#2E3A59" />
                            <Editor Text="{Binding ProductDescription}" 
                                    Placeholder="Ürün açıklaması"
                                    HeightRequest="80"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#2E3A59" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Error Message -->
                <Frame BackgroundColor="#FFEBEE" 
                       CornerRadius="12" 
                       Padding="20"
                       BorderColor="#FFCDD2"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <Label Text="⚠️" 
                               FontSize="20" 
                               VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C62828"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand" />
                    </StackLayout>
                </Frame>

            </StackLayout>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="❌ İptal"
                        BackgroundColor="#FF6B6B"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="0,0,10,0"
                        FontSize="17"
                        FontAttributes="Bold"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="💾 Kaydet"
                        BackgroundColor="#4ECDC4"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="10,0,0,0"
                        FontSize="17"
                        FontAttributes="Bold"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsFormValid}" />
            </Grid>

            <!-- Loading Indicator -->
            <Frame Grid.Row="1"
                   BackgroundColor="White"
                   CornerRadius="20"
                   IsVisible="{Binding IsLoading}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Padding="40">
                <StackLayout Spacing="20" HorizontalOptions="Center">
                    <ActivityIndicator IsVisible="{Binding IsLoading}"
                                      IsRunning="{Binding IsLoading}"
                                      Color="#667EEA"
                                      WidthRequest="50"
                                      HeightRequest="50" />
                    <Label Text="İşleniyor..."
                           TextColor="#2E3A59"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

        </Grid>
    </ScrollView>

</ContentPage>