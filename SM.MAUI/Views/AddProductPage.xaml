<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.AddProductPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             Title="Ürün Ekleme Sayfası"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Frame Grid.Row="0"
                   BackgroundColor="#667EEA"
                   CornerRadius="15"
                   Margin="0,0,0,25"
                   Padding="25">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                    <Label Text="📦" FontSize="28" VerticalOptions="Center" />
                    <Label Text="Yeni Ürün Ekle"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"
                           Margin="10,0,0,0" />
                </StackLayout>
            </Frame>

            <!-- Form -->
            <StackLayout Grid.Row="1" Spacing="20">

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="10">

                    <dx:DataFormView x:Name="dataForm"
                                     DataObject="{Binding ProductForm}"
                                     CommitMode="Manually"
                                     ValidationMode="Input"
                                     ReserveBottomTextLine="True"
                                     BackgroundColor="Transparent">

                        <dx:DataFormTextItem FieldName="Name"
                                             LabelText="Ürün Adı *"
                                             Placeholder="Ürün adını girin" />

                        <dx:DataFormTextItem FieldName="SKU"
                                             LabelText="SKU (Stok Kodu) *"
                                             Placeholder="Benzersiz stok kodu" />

                        <dx:DataFormNumericItem FieldName="Price"
                                                LabelText="Satış Fiyatı *"
                                                Placeholder="Fiyat" />

                        <dx:DataFormComboBoxItem FieldName="WarehouseId"
                                                 LabelText="Depo *"
                                                 Placeholder="Depo seçin"
                                                 ItemsSource="{Binding Warehouses}"
                                                 DisplayMember="DisplayName"
                                                 ValueMember="Id" />

                        <dx:DataFormNumericItem FieldName="InitialStock"
                                                LabelText="Başlangıç Stok Miktarı"
                                                Placeholder="Opsiyonel" />

                        <dx:DataFormMultilineItem FieldName="Description"
                                                  LabelText="Ürün Açıklaması"
                                                  Placeholder="Ürün hakkında açıklama..."
                                                  MinLineCount="3" />
                    </dx:DataFormView>
                </Frame>

                <!-- Success Message -->
                <Frame BackgroundColor="#E8F5E8"
                       CornerRadius="12"
                       Padding="20"
                       BorderColor="#C8E6C9"
                       IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <Label Text="✅" FontSize="20" VerticalOptions="Center" />
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="#2E7D32"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Fill" />
                    </StackLayout>
                </Frame>

            </StackLayout>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="❌ İptal"
                        BackgroundColor="#FF6B6B"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="0,0,10,0"
                        FontSize="17"
                        FontAttributes="Bold"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="💾 Kaydet"
                        BackgroundColor="#4ECDC4"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="10,0,0,0"
                        FontSize="17"
                        FontAttributes="Bold"
                        Clicked="OnSaveClicked"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

            <!-- Loading Indicator -->
            <Frame Grid.Row="1"
                   BackgroundColor="White"
                   CornerRadius="20"
                   IsVisible="{Binding IsLoading}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Padding="40">
                <StackLayout Spacing="20" HorizontalOptions="Center">
                    <ActivityIndicator IsVisible="{Binding IsLoading}"
                                       IsRunning="{Binding IsLoading}"
                                       Color="#667EEA"
                                       WidthRequest="50"
                                       HeightRequest="50" />
                    <Label Text="Ürün kaydediliyor..."
                           TextColor="#2E3A59"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

        </Grid>
    </ScrollView>

</ContentPage>