<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.UserSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Stokify - Hoş Geldiniz"
             BackgroundColor="#1E3A8A"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst Kısım - Logo ve Başlık -->
        <StackLayout Grid.Row="0" VerticalOptions="Center" Spacing="20">
            <Label Text="📦" 
                   FontSize="80" 
                   HorizontalOptions="Center"
                   TextColor="White" />

            <Label Text="STOKIFY" 
                   FontSize="32" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White" />

            <Label Text="Envanter Yönetim Sistemi" 
                   FontSize="16" 
                   HorizontalOptions="Center"
                   TextColor="#E0E7FF"
                   Margin="0,0,0,20" />
        </StackLayout>

        <!-- Orta Kısım - Kullanıcı Seçimi -->
        <StackLayout Grid.Row="1" Spacing="30" Padding="40,20">

            <Label Text="Lütfen kullanıcı tipinizi seçin:" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"
                   Margin="0,0,0,30" />

            <!-- Admin Kartı -->
            <Frame BackgroundColor="White" 
                   CornerRadius="20" 
                   Padding="0"
                   HasShadow="True"
                   HeightRequest="120">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdminSelected" />
                </Frame.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20">
                    <Frame Grid.Column="0" 
                           BackgroundColor="#10B981" 
                           CornerRadius="25" 
                           WidthRequest="50" 
                           HeightRequest="50"
                           HasShadow="False"
                           Padding="0"
                           VerticalOptions="Center">
                        <Label Text="👨‍💼" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Margin="20,0,0,0">
                        <Label Text="YÖNETİCİ" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="#1F2937" />
                        <Label Text="Tüm sistem özelliklerine erişim" 
                               FontSize="12" 
                               TextColor="#6B7280" />
                        <Label Text="• Dashboard • Raporlar • Depo/Ürün Yönetimi" 
                               FontSize="10" 
                               TextColor="#9CA3AF"
                               Margin="0,5,0,0" />
                    </StackLayout>

                    <Label Grid.Column="2" 
                           Text="→" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#10B981"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Depo Çalışanı Kartı -->
            <Frame BackgroundColor="White" 
                   CornerRadius="20" 
                   Padding="0"
                   HasShadow="True"
                   HeightRequest="120">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnWarehouseEmployeeSelected" />
                </Frame.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20">
                    <Frame Grid.Column="0" 
                           BackgroundColor="#3B82F6" 
                           CornerRadius="25" 
                           WidthRequest="50" 
                           HeightRequest="50"
                           HasShadow="False"
                           Padding="0"
                           VerticalOptions="Center">
                        <Label Text="👷‍♂️" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Margin="20,0,0,0">
                        <Label Text="DEPO ÇALIŞANI" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="#1F2937" />
                        <Label Text="Stok işlemleri ve ürün görüntüleme" 
                               FontSize="12" 
                               TextColor="#6B7280" />
                        <Label Text="• Stok Giriş/Çıkış • Barkod Okuma • Ürün Listesi" 
                               FontSize="10" 
                               TextColor="#9CA3AF"
                               Margin="0,5,0,0" />
                    </StackLayout>

                    <Label Grid.Column="2" 
                           Text="→" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#3B82F6"
                           VerticalOptions="Center" />
                </Grid>
            </Frame>

        </StackLayout>

        <!-- Alt Kısım - Bilgi -->
        <StackLayout Grid.Row="2" VerticalOptions="End" Padding="20">
            <Frame BackgroundColor="#1E40AF" 
                   CornerRadius="15" 
                   Padding="15"
                   HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="💡" FontSize="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" 
                           FontSize="12" 
                           TextColor="#E0E7FF"
                           VerticalOptions="Center"
                           Margin="10,0,0,0"
                           LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="İpucu: " FontAttributes="Bold" />
                                <Span Text="Kullanıcı tipinizi seçtikten sonra sadece yetkiniz olan özellikleri görebileceksiniz. İstediğiniz zaman ana menüden değiştirebilirsiniz." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            </Frame>

            <Label Text="Stokify v1.0 - Envanter Yönetim Sistemi" 
                   FontSize="10" 
                   HorizontalOptions="Center"
                   TextColor="#9CA3AF"
                   Margin="0,15,0,10" />
        </StackLayout>
    </Grid>

</ContentPage>