<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.AddWarehousePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SM.MAUI.Converters"
             Title="{Binding Title}"
             BackgroundColor="#F5F7FA">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ana Form İçeriği -->
        <ScrollView Grid.Row="0" Padding="15">
            <StackLayout Spacing="20">

                <!-- Başlık -->
                <Frame BackgroundColor="#2E86AB" 
                       CornerRadius="20" 
                       Padding="20"
                       HasShadow="True"
                       Margin="0,10,0,0">
                    <StackLayout>
                        <Label Text="🏪 Yeni Depo Ekle"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Depo Bilgilerini Doldurun"
                               FontSize="12"
                               TextColor="#E8F4F8"
                               HorizontalOptions="Center"
                               Margin="0,5,0,0" />
                    </StackLayout>
                </Frame>

                <!-- Loading -->
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="#2E86AB"
                                   HeightRequest="60"
                                   WidthRequest="60"
                                   HorizontalOptions="Center" />

                <!-- Form Kartı -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="True"
                       IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <StackLayout Spacing="20">

                        <!-- Depo Adı -->
                        <StackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                <Label Grid.Column="0" Text="🏷️" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Depo Adı" 
                                       FontSize="16"
                                       FontAttributes="Bold" 
                                       TextColor="#2E86AB"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                                <Label Grid.Column="2" Text="*" 
                                       FontSize="16"
                                       FontAttributes="Bold" 
                                       TextColor="#DC3545"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="0" 
                                   HasShadow="False">
                                <Entry x:Name="WarehouseNameEntry"
                                       Text="{Binding WarehouseName}" 
                                       Placeholder="Depo adını girin."
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="Transparent"
                                       TextColor="#212529"
                                       FontSize="14"
                                       Margin="15,8" />
                            </Frame>
                            <Label Text="{Binding NameError}"
                                   TextColor="#DC3545"
                                   FontSize="12"
                                   Margin="10,5,0,0"
                                   IsVisible="{Binding NameError, Converter={StaticResource StringToBoolConverter}}" />
                        </StackLayout>

                        <!-- Lokasyon -->
                        <StackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                <Label Grid.Column="0" Text="📍" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Lokasyon" 
                                       FontSize="16"
                                       FontAttributes="Bold" 
                                       TextColor="#2E86AB"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                                <Label Grid.Column="2" Text="*" 
                                       FontSize="16"
                                       FontAttributes="Bold" 
                                       TextColor="#DC3545"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="0" 
                                   HasShadow="False">
                                <Entry x:Name="LocationEntry"
                                       Text="{Binding Location}" 
                                       Placeholder="Lokasyon girin."
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="Transparent"
                                       TextColor="#212529"
                                       FontSize="14"
                                       Margin="15,8" />
                            </Frame>
                            <Label Text="{Binding LocationError}"
                                   TextColor="#DC3545"
                                   FontSize="12"
                                   Margin="10,5,0,0"
                                   IsVisible="{Binding LocationError, Converter={StaticResource StringToBoolConverter}}" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Hata Mesajı -->
                <Frame BackgroundColor="#F8D7DA"
                       BorderColor="#DC3545"
                       CornerRadius="10"
                       Padding="15"
                       IsVisible="{Binding HasError}"
                       HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="❌" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ErrorMessage}"
                               FontSize="14"
                               TextColor="#721C24"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Frame>

                <!-- Bilgi Kutusu -->
                <Frame BackgroundColor="#E3F2FD"
                       BorderColor="#2196F3"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="💡" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" FontSize="12" 
                               TextColor="#1565C0"
                               VerticalOptions="Center"
                               Margin="8,0,0,0"
                               LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="* ile işaretli alanlar zorunludur. " FontAttributes="Bold" />
                                    <Span Text="Depo adı benzersiz olmalı ve lokasyon bilgisi detaylı verilmelidir." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Frame>

                <!-- Alt boşluk -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>

        <!-- Alt Butonlar -->
        <Frame Grid.Row="1" 
               BackgroundColor="White" 
               CornerRadius="15" 
               Padding="20,15,20,20"
               HasShadow="True">
            <Grid ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- İptal Butonu -->
                <Button Grid.Column="0"
                        Text="❌ İptal"
                        BackgroundColor="#6C757D"
                        TextColor="White"
                        CornerRadius="15"
                        HeightRequest="50"
                        FontSize="14"
                        FontAttributes="Bold"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Kaydet Butonu -->
                <Button Grid.Column="1"
                        Text="💾 Depo Ekle"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        CornerRadius="15"
                        HeightRequest="50"
                        FontSize="14"
                        FontAttributes="Bold"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsFormValid}" />
            </Grid>
        </Frame>
    </Grid>

</ContentPage>