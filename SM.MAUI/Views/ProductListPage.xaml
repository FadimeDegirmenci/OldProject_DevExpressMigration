<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.ProductListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxg="clr-namespace:DevExpress.Maui.DataGrid;assembly=DevExpress.Maui.DataGrid"
             xmlns:converters="clr-namespace:SM.MAUI.Converters"
             Title="Ürün Listesi">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar (aynen kalıyor) -->
        <Grid Grid.Row="0" Padding="15" BackgroundColor="#2E86AB">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Text="Ürün Listesi" FontSize="20"
                   FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />

            <Button Grid.Column="1" Text="🔄" BackgroundColor="#28A745" TextColor="White"
                    CornerRadius="8" Margin="5,0" WidthRequest="40" HeightRequest="40"
                    FontSize="16" Command="{Binding RefreshCommand}" />

            <Button Grid.Column="2" Text="➕" BackgroundColor="#17A2B8" TextColor="White"
                    CornerRadius="8" Margin="5,0" WidthRequest="40" HeightRequest="40"
                    FontSize="16" Command="{Binding AddProductCommand}" />

            <Button Grid.Column="3" Text="🏠" BackgroundColor="#FFC107" TextColor="#495057"
                    CornerRadius="8" WidthRequest="40" HeightRequest="40" FontSize="16"
                    Clicked="OnBackToMainClicked" />
        </Grid>

        <!-- Loading / Error (aynen kalıyor) -->
        <ActivityIndicator Grid.Row="1" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                          Color="#2E86AB" VerticalOptions="Center" HorizontalOptions="Center"
                          HeightRequest="60" WidthRequest="60" />

        <Frame Grid.Row="1" BackgroundColor="#F8D7DA" BorderColor="#DC3545" CornerRadius="10"
               Padding="20" Margin="20" IsVisible="{Binding HasError}" VerticalOptions="Center" HasShadow="False">
            <StackLayout>
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="❌" FontSize="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ErrorMessage}" TextColor="#721C24"
                           FontSize="16" VerticalOptions="Center" Margin="10,0,0,0" LineBreakMode="WordWrap" />
                </Grid>
                <Button Text="🔄 Tekrar Dene" BackgroundColor="#DC3545" TextColor="White"
                        CornerRadius="8" Margin="0,15,0,0" Command="{Binding RefreshCommand}" />
            </StackLayout>
        </Frame>

        <!-- Ürün Grid'i -->
        <dxg:DataGridView Grid.Row="1"
                           x:Name="productGrid"
                           ItemsSource="{Binding Products}"
                           IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                           AutoGenerateColumnsMode="None"
                           TapConfirmed="OnProductTapConfirmed"
                           Margin="10,5">

            <dxg:DataGridView.Columns>
                <dxg:TextColumn FieldName="Name" Caption="Ürün Adı"/>
                <dxg:TextColumn FieldName="SKU" Caption="SKU"/>
                <dxg:NumberColumn FieldName="Price" Caption="Fiyat (TL)" DisplayFormat="F2"/>
                <dxg:DateColumn FieldName="CreatedDate" Caption="Eklenme Tarihi" DisplayFormat="dd.MM.yyyy"/>
            </dxg:DataGridView.Columns>

            <!-- Sağdan sola kaydırınca "Sil" butonu çıkar, DeleteProductCommand'a bağlanır -->
            <dxg:DataGridView.EndSwipeItems>
                <dxg:GridSwipeItem Caption="🗑️ Sil"
                                    BackgroundColor="#DC3545"
                                    Width="80"
                                    Command="{Binding DeleteProductCommand}"/>
            </dxg:DataGridView.EndSwipeItems>
        </dxg:DataGridView>
    </Grid>
</ContentPage>