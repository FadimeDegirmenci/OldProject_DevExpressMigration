<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SM.MAUI.Views.WarehouseListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SM.MAUI.Converters"
             Title="Depo Listesi">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="15" BackgroundColor="#2E86AB">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" 
                   Text="🏪 Depo Listesi" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="🔄"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="5,0"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="16"
                    Command="{Binding RefreshCommand}" />

            <Button Grid.Column="2"
                    Text="➕"
                    BackgroundColor="#17A2B8"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="5,0"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="16"
                    Command="{Binding AddWarehouseCommand}" />

            <Button Grid.Column="3"
                    Text="🏠"
                    BackgroundColor="#FFC107"
                    TextColor="#495057"
                    CornerRadius="8"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="16"
                    Clicked="OnBackToMainClicked" />
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsVisible="{Binding IsBusy}"
                          IsRunning="{Binding IsBusy}"
                          Color="#2E86AB"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          HeightRequest="60"
                          WidthRequest="60" />

        <!-- Error Message -->
        <Frame Grid.Row="1"
               BackgroundColor="#F8D7DA"
               BorderColor="#DC3545"
               CornerRadius="10"
               Padding="20"
               Margin="20"
               IsVisible="{Binding HasError}"
               VerticalOptions="Center"
               HasShadow="False">
            <StackLayout>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding ErrorMessage}"
                           TextColor="#721C24"
                           FontSize="16"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap" />
                    <Button Grid.Column="1" 
                            Text="❌"
                            BackgroundColor="Transparent"
                            TextColor="#DC3545"
                            FontSize="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Command="{Binding ClearErrorCommand}"
                            VerticalOptions="Start" />
                </Grid>
                <Button Text="🔄 Tekrar Dene" 
                        BackgroundColor="#DC3545"
                        TextColor="White"
                        CornerRadius="8"
                        Margin="0,15,0,0"
                        Command="{Binding RefreshCommand}" />
            </StackLayout>
        </Frame>

        <!-- Warehouses List -->
        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding Warehouses}"
                       IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                       BackgroundColor="#F8F9FA"
                       Margin="10,5">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Frame BackgroundColor="White" 
                               CornerRadius="12" 
                               HasShadow="True"
                               Padding="15"
                               Margin="0,5">

                            <!-- Gesture Recognizers -->
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.WarehouseTappedCommand}"
                                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Depo Adı -->
                                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="🏪" FontSize="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#212529"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>

                                <!-- Status Badge -->
                                <Frame Grid.Row="0" Grid.Column="1"
                                       BackgroundColor="#E8F5E8"
                                       CornerRadius="8"
                                       Padding="8,4"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="Aktif"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#28A745" />
                                </Frame>

                                <!-- Lokasyon -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="📍" FontSize="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Location}"
                                           FontSize="14"
                                           TextColor="#6C757D"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           Margin="5,0,0,0" />
                                </Grid>

                                <!-- Alt Bilgi -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0" Text="📅" FontSize="12" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding CreatedDate, StringFormat='{0:dd.MM.yyyy}'}"
                                           FontSize="11"
                                           TextColor="#6C757D"
                                           VerticalOptions="Center"
                                           Margin="5,0,0,0" />
                                    <Label Grid.Column="2" Text="👆 Detaylar için tıklayın"
                                           FontSize="10"
                                           TextColor="#6C757D"
                                           FontAttributes="Italic"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       Padding="30"
                       Margin="20"
                       HasShadow="True"
                       VerticalOptions="Center">
                    <StackLayout>
                        <Label Text="🏪" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Henüz depo yok" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#6C757D"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="İlk deponuzu eklemek için yukarıdaki + butonuna tıklayın." 
                               FontSize="14"
                               TextColor="#6C757D"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,20" />
                        <Button Text="➕ Depo Ekle" 
                                BackgroundColor="#17A2B8"
                                TextColor="White"
                                CornerRadius="20"
                                HeightRequest="45"
                                Command="{Binding AddWarehouseCommand}" />
                    </StackLayout>
                </Frame>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</ContentPage>